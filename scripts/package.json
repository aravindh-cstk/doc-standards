{
  "name": "doc-standards-linter",
  "version": "1.0.0",
  "description": "Mechanical rule checker for docs against doc-standards/",
  "private": true,
  "bin": {
    "lint-doc": "./lint-doc.js"
  },
  "scripts": {
    "audit:wordlists": "node audit-wordlists.js",
    "build:readme": "node build/build-readme-rules.js",
    "build:section-order": "node build/build-section-order.js",
    "classify": "node classify-doc-type.js ../../docs",
    "classify:apply": "node classify-doc-type.js --apply",
    "classify:judge": "node classify-doc-type.js --judge",
    "discover:tone": "node judge-tone.js ../../docs --discover --probe",
    "fix:dashes": "node fix/fix-dashes.js ../../docs --report",
    "gate": "npm test && npm run links && npm run sweep:tier1",
    "judge": "node review-candidates.js --judge",
    "judge:cohesion": "node judge-tone.js ../../docs --rules=C2-09 --emit-verdicts",
    "judge:refs": "node judge-tone.js ../../docs --rules=C3-25 --emit-verdicts",
    "judge:tone": "node judge-tone.js ../../docs",
    "links": "node check-links.js ../../docs --layers=internal,labels",
    "lint": "node lint-doc.js",
    "lint:api-ref": "node lint-api-ref.js",
    "mirror": "node sync-mirror.js ../../docs/skills/src ../../docs/docs/prompts --index=../../docs/skills/skills-index.md --mirror-only=index.md,skills-index.md",
    "mirror:fix": "node sync-mirror.js ../../docs/skills/src ../../docs/docs/prompts --index=../../docs/skills/skills-index.md --mirror-only=index.md,skills-index.md --apply",
    "probe": "node probe-corpus.js",
    "reading": "node judge-reading.js ../../docs",
    "reading:judge": "node judge-reading.js --judge",
    "reading:report": "node judge-reading.js --report",
    "review": "node review-candidates.js",
    "review:cohesion": "node review-candidates.js ../../docs",
    "review:refs": "node review-candidates.js ../../docs",
    "sweep": "node sweep-docs.js ../../docs",
    "sweep:tier1": "node sweep-docs.js ../../docs --tiers=1",
    "test": "node --test test/*.test.js"
  }
}
